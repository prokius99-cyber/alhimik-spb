---
/**
 * Как добраться: адрес, часы, кнопки маршрута в Яндекс.Картах и 2ГИС, карта по нажатию.
 * Карта не грузится, пока её не попросили: не тормозит страницу и не шлёт данные посетителя заранее.
 *
 * <MapCard note="Вход со двора, 2 этаж" />
 */
import { business } from '../data/site';
interface Props { note?: string; title?: string }
const { note = business.address.note, title = 'Как добраться' } = Astro.props;
const q = encodeURIComponent(`${business.address.city}, ${business.address.street}`);
const ya = business.links.yandexMaps || `https://yandex.ru/maps/?text=${q}`;
const gis = business.links.twoGis || `https://2gis.ru/search/${q}`;
const { lat, lon } = business.geo;
const widget = lat ? `https://yandex.ru/map-widget/v1/?ll=${lon}%2C${lat}&z=16&pt=${lon}%2C${lat}%2Cpm2rdm` : '';
---
<div class="mapcard">
  <div class="mc-info">
    <h3>{title}</h3>
    <p class="mc-addr">{business.address.city}, {business.address.street}</p>
    {note && <p class="mc-note">{note}</p>}
    {business.hoursDisplay && <p class="mc-hours">{business.hoursDisplay}</p>}
    <div class="mc-actions">
      <a href={ya} target="_blank" rel="noopener">Маршрут в Яндекс.Картах</a>
      <a href={gis} target="_blank" rel="noopener">Открыть в 2ГИС</a>
    </div>
  </div>
  {widget && (
    <div class="mc-map" data-map={widget}>
      <button type="button" class="mc-load">Показать карту</button>
    </div>
  )}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((box) => {
    box.querySelector('button')?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = box.dataset.map!;
      f.title = 'Карта';
      f.loading = 'lazy';
      f.setAttribute('allowfullscreen', '');
      box.replaceChildren(f);
    });
  });
</script>

<style>
  .mapcard { display: grid; gap: var(--s-6); grid-template-columns: 1fr; }
  @media (min-width: 860px) { .mapcard { grid-template-columns: 1fr 1.2fr; align-items: stretch; } }
  .mc-info h3 { font-size: var(--t-h3); margin-bottom: var(--s-3); }
  .mc-addr { font-weight: 600; margin: 0; }
  .mc-note, .mc-hours { color: var(--c-muted); margin: var(--s-2) 0 0; }
  .mc-actions { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-top: var(--s-6); }
  .mc-actions a { min-height: var(--tap); display: inline-flex; align-items: center; padding: 0 var(--s-4); border: 1px solid var(--c-border); border-radius: var(--r-md); text-decoration: none; font-weight: 600; }
  .mc-map { min-height: 320px; border-radius: var(--r-lg); overflow: hidden; background: var(--c-surface); display: grid; place-items: center; }
  .mc-map :global(iframe) { width: 100%; height: 100%; min-height: 320px; border: 0; }
  .mc-load { min-height: var(--tap); padding: 0 var(--s-6); border: 1px solid var(--c-border); border-radius: var(--r-md); background: var(--c-bg); color: var(--c-text); font: 600 1rem var(--f-body); cursor: pointer; }
</style>
