---
/**
 * Главная «Алхимика». Порядок секций — SPEC.md «Решения», раскладка — DESIGN.md §5.
 * У каждой секции data-section из .premiumsite/gate.config.json.
 */
import Base from '../layouts/Base.astro';
import ContactBar from '../components/ContactBar.astro';
import Hero from '../sections/Hero.astro';
import Lab from '../sections/Lab.astro';
import Elixirs from '../sections/Elixirs.astro';
import Reviews from '../sections/Reviews.astro';
import Banquets from '../sections/Banquets.astro';
import Visit from '../sections/Visit.astro';
import { business } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Реквизиты не выводим, пока владелец их не подтвердил.
const operator = business.legal.operator.includes('{{VERIFY') ? '' : business.legal.operator;
---
<Base title={`${business.name} — бар-таверна в цоколе на Савушкина, 143к1`}>
  <main id="main">
    <Hero />
    <Lab />
    <Elixirs />
    <Reviews />
    <Banquets />
    <Visit />
  </main>

  <footer class="site-footer">
    <div class="container-x foot">
      <p>{business.name}, {business.address.city}, {business.address.street}, {business.address.note}</p>
      <p><a class="link" href={`${base}/privacy`}>Политика конфиденциальности</a></p>
      {operator && <p>{operator}</p>}
    </div>
  </footer>

  <ContactBar />
</Base>

<style>
  .site-footer { padding-block: var(--s-12) calc(var(--s-12) + var(--btn-h)); color: var(--c-muted); font-size: var(--t-small); background: var(--c-night-deep); }
  @media (min-width: 768px) { .site-footer { padding-bottom: var(--s-12); } }
  .foot p { margin: 0 0 var(--s-2); }
</style>
