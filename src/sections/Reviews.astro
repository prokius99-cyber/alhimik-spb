---
/**
 * «Что говорят гости»: барная стойка, на ней россыпью бирдекели (DESIGN.md §4, §5).
 * Два больших — рейтинги карт, четыре малых — дословные цитаты 2ГИС (analysis.md → «Отзывы» → «Хвалят»).
 */
import { business } from '../data/site';

const yandexUrl = business.links.yandexMaps;
const twoGisUrl = 'https://2gis.ru/spb/firm/5348552838784048/tab/reviews';

const quotes = [
  'Замечательный и оригинальный интерьер',
  'Горячие блюда вкуснее, чем в некоторых ресторанах',
  'Вкусные наливки и коктейли',
  'Цены вполне демократичные',
];

// Знаки стихий: огонь, вода, воздух, земля, солнце, серебро — тиснение на картоне.
const signs = [
  { id: 'fire', d: 'M12 3 L22 20 H2 Z' },
  { id: 'water', d: 'M2 4 H22 L12 21 Z' },
  { id: 'air', d: 'M12 3 L22 20 H2 Z M5.5 14 H18.5' },
  { id: 'earth', d: 'M2 4 H22 L12 21 Z M6 10 H18' },
  { id: 'sun', d: 'M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 M12 11 A1 1 0 1 0 12 13 A1 1 0 1 0 12 11' },
  { id: 'moon', d: 'M16 3 A9 9 0 1 0 16 21 A7 7 0 1 1 16 3' },
];
// Расстановка знаков на картоне: [знак, x, y, масштаб, поворот]
const layouts: Array<Array<[string, number, number, number, number]>> = [
  [['fire', 6, 8, 1.6, -8], ['sun', 62, 14, 1.3, 10], ['moon', 14, 62, 1.4, 6], ['water', 66, 66, 1.7, -4]],
  [['air', 60, 6, 1.5, 6], ['earth', 8, 14, 1.3, -10], ['sun', 12, 66, 1.6, 4], ['fire', 64, 62, 1.3, 12]],
  [['moon', 8, 10, 1.5, -6], ['water', 62, 12, 1.4, 8], ['earth', 62, 66, 1.5, -8], ['air', 10, 64, 1.3, 6]],
  [['sun', 60, 8, 1.4, -4], ['fire', 8, 40, 1.5, 8], ['moon', 64, 62, 1.6, 6], ['earth', 20, 74, 1.1, -6]],
  [['water', 8, 8, 1.5, 6], ['air', 64, 40, 1.4, -8], ['sun', 14, 66, 1.4, 8], ['moon', 62, 8, 1.2, -4]],
  [['earth', 62, 10, 1.4, 8], ['fire', 10, 12, 1.2, -6], ['air', 14, 64, 1.6, -4], ['water', 64, 62, 1.4, 10]],
];
---
<section id="reviews" data-section="reviews" data-zone="cellar" aria-labelledby="reviews-title" class="rv">
  <div class="rv-head container-x">
    <h2 id="reviews-title">Что говорят гости</h2>
  </div>

  <svg class="rv-defs" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      {signs.map((s) => (
        <symbol id={`rv-${s.id}`} viewBox="0 0 24 24"><path d={s.d} fill="none" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round" /></symbol>
      ))}
    </defs>
  </svg>

  <div class="rv-bar">
    <div class="rv-top container-x">
      <div class="rv-col rv-col-a">
        <article class="coaster coaster-big t-l">
          <svg class="signs" viewBox="0 0 100 100" aria-hidden="true">
            {layouts[0].map(([id, x, y, k, r]) => (
              <use href={`#rv-${id}`} x={x} y={y} width={24 * k} height={24 * k} transform={`rotate(${r} ${x + 12 * k} ${y + 12 * k})`} />
            ))}
          </svg>
          <p class="score"><span class="num">4,6</span></p>
          <h3>Яндекс Карты</h3>
          <p class="count">470&nbsp;оценок</p>
          <a class="link stretch" href={yandexUrl} target="_blank" rel="noopener">Читать отзывы на&nbsp;Яндекс Картах</a>
        </article>
        <figure class="coaster coaster-small t-r q-shift-1">
          <svg class="signs" viewBox="0 0 100 100" aria-hidden="true">
            {layouts[2].map(([id, x, y, k, r]) => (
              <use href={`#rv-${id}`} x={x} y={y} width={24 * k} height={24 * k} transform={`rotate(${r} ${x + 12 * k} ${y + 12 * k})`} />
            ))}
          </svg>
          <blockquote>«{quotes[1]}»</blockquote>
          <figcaption class="muted">2ГИС, отзыв</figcaption>
        </figure>
      </div>

      <div class="rv-col rv-col-b">
        <figure class="coaster coaster-small t-r2 q-shift-0">
          <svg class="signs" viewBox="0 0 100 100" aria-hidden="true">
            {layouts[1].map(([id, x, y, k, r]) => (
              <use href={`#rv-${id}`} x={x} y={y} width={24 * k} height={24 * k} transform={`rotate(${r} ${x + 12 * k} ${y + 12 * k})`} />
            ))}
          </svg>
          <blockquote>«{quotes[0]}»</blockquote>
          <figcaption class="muted">2ГИС, отзыв</figcaption>
        </figure>
        <article class="coaster coaster-big t-l2">
          <svg class="signs" viewBox="0 0 100 100" aria-hidden="true">
            {layouts[3].map(([id, x, y, k, r]) => (
              <use href={`#rv-${id}`} x={x} y={y} width={24 * k} height={24 * k} transform={`rotate(${r} ${x + 12 * k} ${y + 12 * k})`} />
            ))}
          </svg>
          <p class="score"><span class="num">4,3</span></p>
          <h3>2ГИС</h3>
          <p class="count">70&nbsp;оценок</p>
          <a class="link stretch" href={twoGisUrl} target="_blank" rel="noopener">Читать отзывы в&nbsp;2ГИС</a>
        </article>
      </div>

      <div class="rv-col rv-col-c">
        <figure class="coaster coaster-small t-l q-shift-2">
          <svg class="signs" viewBox="0 0 100 100" aria-hidden="true">
            {layouts[4].map(([id, x, y, k, r]) => (
              <use href={`#rv-${id}`} x={x} y={y} width={24 * k} height={24 * k} transform={`rotate(${r} ${x + 12 * k} ${y + 12 * k})`} />
            ))}
          </svg>
          <blockquote>«{quotes[2]}»</blockquote>
          <figcaption class="muted">2ГИС, отзыв</figcaption>
        </figure>
        <figure class="coaster coaster-small t-r3 q-shift-3">
          <svg class="signs" viewBox="0 0 100 100" aria-hidden="true">
            {layouts[5].map(([id, x, y, k, r]) => (
              <use href={`#rv-${id}`} x={x} y={y} width={24 * k} height={24 * k} transform={`rotate(${r} ${x + 12 * k} ${y + 12 * k})`} />
            ))}
          </svg>
          <blockquote>«{quotes[3]}»</blockquote>
          <figcaption class="muted">2ГИС, отзыв</figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  .rv { padding-top: var(--section-y); }
  .rv-defs { position: absolute; }
  .rv-head { padding-bottom: var(--s-12); }

  /* Стойка: тёмное дерево — предмет, не линия. Волокна — тёмные штрихи, свет лампы — пятно. */
  .rv-bar {
    position: relative;
    padding-block: var(--s-16) var(--section-y);
    background:
      radial-gradient(60% 70% at 30% 20%, color-mix(in srgb, var(--c-secondary) 30%, transparent), transparent 70%),
      repeating-linear-gradient(176deg, transparent 0 9px, color-mix(in srgb, var(--c-frame) 28%, transparent) 9px 10px, transparent 10px 23px, color-mix(in srgb, var(--c-frame) 16%, transparent) 23px 25px),
      repeating-linear-gradient(178deg, transparent 0 41px, color-mix(in srgb, var(--c-shelf) 60%, var(--c-frame)) 41px 43px),
      linear-gradient(180deg, color-mix(in srgb, var(--c-shelf) 70%, var(--c-frame)) 0, var(--c-shelf) 38%, color-mix(in srgb, var(--c-shelf) 80%, var(--c-frame)) 100%);
    box-shadow: inset 0 18px 30px -10px color-mix(in srgb, var(--c-frame) 70%, transparent);
  }

  .rv-top { display: flex; flex-direction: column; gap: 0; }
  .rv-col { display: flex; flex-direction: column; }

  .coaster {
    position: relative; margin: 0; padding: var(--s-6);
    aspect-ratio: 1; width: min(calc(100% - var(--s-8)), 17.5rem);
    background: var(--c-surface); color: var(--c-text);
    border-radius: var(--r-lg); box-shadow: var(--shadow-object);
    display: flex; flex-direction: column; justify-content: flex-end; overflow: hidden;
    transition: transform var(--d-state) var(--e-out);
  }
  .coaster-big { width: min(calc(100% - var(--s-8)), 20rem); padding: var(--s-8); }
  .signs {
    position: absolute; inset: 0; width: 100%; height: 100%;
    color: var(--c-border); opacity: 0.14; pointer-events: none;
  }
  .coaster > :not(.signs) { position: relative; }

  .score { margin: 0; font: 400 clamp(5rem, 14vw, 7.5rem)/0.9 var(--f-display); letter-spacing: 0; }
  .coaster h3 { margin-top: var(--s-2); font-size: var(--t-h3); }
  .count { margin: var(--s-1) 0 var(--s-4); color: var(--c-muted); font-size: var(--t-body); }
  .stretch { align-self: flex-start; }
  .stretch::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .coaster:has(.stretch:focus-visible) { outline: 2px solid var(--c-accent-text); outline-offset: 3px; }
  .stretch:focus-visible { outline: none; }

  blockquote { margin: 0 0 var(--s-3); font: 400 var(--t-lead)/1.25 var(--f-display); text-wrap: balance; }
  figcaption { font-size: var(--t-small); font-weight: 600; }

  /* 390: стопка со сдвигами влево-вправо */
  .t-l { transform: rotate(-2.5deg); }
  .t-r { transform: rotate(2deg); }
  .t-l2 { transform: rotate(-1.5deg); }
  .t-r2 { transform: rotate(3deg); }
  .t-r3 { transform: rotate(-3deg); }
  .rv-col > .coaster { margin-bottom: var(--s-6); }
  .rv-col-a > :nth-child(1) { margin-left: 0; }
  .rv-col-a > :nth-child(2) { margin-left: auto; margin-top: calc(var(--s-6) * -0.5); }
  .rv-col-b > :nth-child(1) { margin-left: var(--s-6); }
  .rv-col-b > :nth-child(2) { margin-left: auto; margin-right: var(--s-2); }
  .rv-col-c > :nth-child(1) { margin-left: 0; }
  .rv-col-c > :nth-child(2) { margin-left: auto; margin-right: var(--s-4); }

  @media (min-width: 768px) {
    .rv-top { flex-direction: row; align-items: flex-start; gap: var(--s-4); }
    .rv-col { flex: 1 1 0; min-width: 0; align-items: center; }
    .rv-col > .coaster { margin: 0 0 var(--s-8); }
    .rv-col-a { padding-top: var(--s-4); }
    .rv-col-b { padding-top: var(--s-24); }
    .rv-col-c { padding-top: var(--s-8); }
    .rv-col-a > :nth-child(2) { margin: calc(var(--s-1) * -3) 0 0 var(--s-12); }
    .rv-col-b > :nth-child(1) { margin: 0 var(--s-8) var(--s-8) 0; }
    .rv-col-b > :nth-child(2) { margin: 0; }
    .rv-col-c > :nth-child(1) { margin: 0 0 var(--s-8) var(--s-6); }
    .rv-col-c > :nth-child(2) { margin: 0 var(--s-8) 0 0; }
  }
  @media (min-width: 1100px) {
    .coaster { width: 17.5rem; }
    .coaster-big { width: 21rem; }
    .rv-col-a { padding-top: 0; }
  }
  @media (hover: hover) {
    .coaster-big:hover { transform: rotate(0deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .coaster { transition: none; }
  }
</style>
