---
/** Дальний зал: самое светлое место сайта. Лампа в центре текста, фото турок уходит за правый край. */
import { Image } from 'astro:assets';
import { business } from '../data/site';
import turks from '../assets/photos/site-07.jpg';
---
<section id="banquets" data-section="banquets" data-zone="cellar" aria-labelledby="banquets-title" class="banquets section-y">
  <figure class="banquets__photo">
    <Image
      src={turks}
      alt="Медные турки для кофе под потолком в зале «Алхимика»"
      width={760}
      loading="lazy"
      sizes="(max-width: 767px) 100vw, 46vw"
      widths={[390, 640]}
    />
  </figure>
  <div class="container-x banquets__grid">
    <div class="banquets__text">
      <h2 id="banquets-title">Зал под&nbsp;праздник</h2>
      <p class="banquets__lead">Банкеты и&nbsp;корпоративы в&nbsp;цоколе. Зал можно закрыть целиком или собраться без&nbsp;закрытия.</p>
      <p class="muted">Условия смотрите в&nbsp;сообщениях нашего сообщества ВКонтакте.</p>
      <div class="banquets__actions">
        <a class="btn" href={`tel:${business.phone.e164}`}>Занять стол</a>
        <a class="link" href={business.links.vk} target="_blank" rel="noopener">Написать в&nbsp;VK</a>
      </div>
    </div>
  </div>
</section>

<style>
  .banquets {
    position: relative;
    overflow-x: clip;
    /* Центр света: лампа над текстом, к краям свет уходит в штукатурку соседей — шва нет. */
    background:
      var(--tex-plaster),
      radial-gradient(ellipse 70% 55% at 30% 50%, color-mix(in srgb, var(--c-secondary) 70%, var(--c-surface)) 0%, var(--c-secondary) 38%, transparent 100%),
      linear-gradient(to bottom, var(--c-bg) 0%, var(--c-secondary) 22%, var(--c-secondary) 78%, var(--c-bg) 100%);
  }
  .banquets__photo {
    position: relative;
    margin: 0 0 var(--s-8);
    height: clamp(14rem, 62vw, 20rem);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 22%, #000 70%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0, #000 22%, #000 70%, transparent 100%);
  }
  .banquets__photo :global(img) {
    width: 100%; height: 100%; object-fit: cover; object-position: 60% 50%;
    filter: sepia(0.35) saturate(0.9);
    mix-blend-mode: multiply;
  }
  .banquets__text { max-width: var(--measure); }
  h2 {
    font: 400 var(--t-h2)/var(--t-h2-lh) var(--f-display);
    margin: 0 0 var(--s-6);
    text-wrap: balance;
  }
  .banquets__lead { font-size: var(--t-lead); line-height: 1.4; font-weight: 500; margin: 0 0 var(--s-4); }
  p { margin: 0; font-size: var(--t-body); line-height: var(--t-body-lh); }
  .banquets__actions { display: grid; gap: var(--s-3); justify-items: stretch; margin-top: var(--s-8); }
  .banquets__actions :global(.link) { justify-content: center; }

  @media (min-width: 768px) {
    .banquets { padding-block: var(--s-24); }
    .banquets__photo {
      position: absolute; right: 0; top: 50%; transform: translateY(-50%);
      width: min(48vw, 46rem); height: min(32rem, 90%); margin: 0;
      -webkit-mask-image:
        linear-gradient(to right, transparent 0, #000 35%),
        linear-gradient(to bottom, transparent 0, #000 18%, #000 82%, transparent 100%);
      -webkit-mask-composite: source-in;
      mask-image:
        linear-gradient(to right, transparent 0, #000 35%),
        linear-gradient(to bottom, transparent 0, #000 18%, #000 82%, transparent 100%);
      mask-composite: intersect;
    }
    .banquets__photo :global(img) { object-position: 30% 50%; }
    .banquets__grid { position: relative; z-index: 1; }
    .banquets__text { max-width: min(var(--measure), 46%); }
    .banquets__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-6); }
    .banquets__actions :global(.link) { justify-content: flex-start; }
  }
</style>
